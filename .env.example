# ── Telegram ──────────────────────────────────────────────
BOT_TOKEN=your_bot_token_here
ADMIN_USER_ID=123456789
# ADMIN_USER_IDS=123456789,987654321

# ── Ma'lumotlar bazasi ────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=tarjimon8
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_FSM_DB=1

# ── Tarjima ───────────────────────────────────────────────
TRANSLATION_PROVIDER=deep_translator
TRANSLATION_TIMEOUT=15
TRANSLATION_MAX_CHARS=4500
TRANSLATION_CACHE_TTL=86400
DEFAULT_SOURCE_LANG=auto
DEFAULT_TARGET_LANG=uz

# ── Tarjima: qo'shimcha pullik provayderlar (ixtiyoriy) ────
# Bo'sh qoldirilsa faqat yuqoridagi bepul TRANSLATION_PROVIDER ishlaydi.
# Ikkalasi ham to'ldirilsa, har so'rovda ular orasidan (hali bepul oylik
# hajmidan oshmagan bo'lsa) TASODIFIY tanlanadi; bittasi tugasa/xato bersa
# ikkinchisiga, ikkalasi ham bo'lmasa bepul provayderga qaytiladi.
# Bir nechta kalit (har biri alohida hisob/loyiha) vergul bilan berilsa,
# navbat bilan — kam ishlatilgani ustunlik bilan — ishlatiladi.
#   Google: https://console.cloud.google.com/ -> "Cloud Translation API"
#           yoqib, shu APIga cheklangan API kalit yarating (service
#           account SHART EMAS — oddiy API kalit yetarli).
#   Azure:  https://portal.azure.com/ -> "Translator" resursi yarating,
#           "Keys and Endpoint"dan kalit va mintaqani (region) oling.
GOOGLE_TRANSLATE_API_KEYS=
GOOGLE_TRANSLATE_FREE_MONTHLY_CHARS=500000
AZURE_TRANSLATOR_KEYS=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_FREE_MONTHLY_CHARS=2000000
#   DeepL:  https://www.deepl.com/pro-api -> bepul (Free) kalit `:fx` bilan
#           tugaydi. Bepul reja 1,000,000 belgi/oy beradi. Amhar (am)ni
#           qo'llab-quvvatlamaydi — kod buni o'zi hisobga oladi.
DEEPL_API_KEYS=
DEEPL_FREE_MONTHLY_CHARS=1000000
#   MyMemory: kalit o'rniga EMAIL (`de` parametri) — 50,000 belgi/KUN.
#           Sifati pastroq, faqat yuqoridagilar yo'q/tugagan/yiqilgan
#           bo'lsa ishlatiladi (deep_translator'dan oldin).
MYMEMORY_EMAILS=
MYMEMORY_FREE_DAILY_CHARS=50000

# Gemini — Google/Azure'ning BEPUL hajmi tugagach ishlatiladigan ARZON
# 2-daraja (Cloud Translation'dan ~40-150 barobar arzon). DIQQAT: bu
# yuqoridagi Google Cloud Translation kalitidan BUTUNLAY BOSHQA narsa —
# https://aistudio.google.com/apikey dan olinadi (Google AI Studio, Cloud
# Translation emas). Oylik hajm hisoblanmaydi (cheklovi belgi soni emas,
# so'rov tezligi — RPM/RPD), shuning uchun FREE_MONTHLY_CHARS shart emas.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-flash-lite-latest

# ── TTS ───────────────────────────────────────────────────
TTS_PROVIDER=edge
TTS_MAX_CHARS=1000

# ── Limitlar ──────────────────────────────────────────────
DAILY_TRANSLATION_LIMIT=50
DAILY_TTS_LIMIT=30
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=60

# ── Limitga yetganda chegirmali VIP taklifi ────────────────
QUICK_VIP_STARS=10
QUICK_VIP_DAYS=30

# ── Rasmdan tarjima (OCR) — bo'sh qoldirilsa o'sha provayder ──
# o'tkazib yuboriladi. Ikkalasi ham bo'sh bo'lsa rasm tarjimasi
# "hozircha sozlanmoqda" deb javob beradi.
#   OCR.Space:    https://ocr.space/ocrapi (ro'yxatdan o'tib bepul kalit).
#                 Bir nechta kalit (har biri alohida email bilan
#                 ro'yxatdan o'tkazilgan) vergul bilan berilsa, navbat
#                 bilan ishlatiladi — bepul hajm shuncha marta ko'payadi.
#   Google Vision: https://console.cloud.google.com/ -> "Cloud Vision API"
#                  yoqib, shu APIga cheklangan API kalit yarating.
OCRSPACE_API_KEYS=key1,key2,key3
OCRSPACE_LANGUAGE=auto
OCRSPACE_FREE_MONTHLY=25000
GOOGLE_VISION_API_KEY=
GOOGLE_VISION_FREE_MONTHLY=1000
DAILY_IMAGE_LIMIT_FREE=3
DAILY_IMAGE_LIMIT_VIP=15

# ── Homiylik: karta rekvizitlari (ixtiyoriy) ───────────────
# Stars hammaga qulay emas (mintaqaviy cheklov) — karta O'zbekiston
# foydalanuvchilari uchun zaxira yo'l. Bo'sh qoldirilsa karta tugmasi
# ko'rsatilmaydi. Bu yerga HAQIQIY qiymat YOZMANG — faqat serverning
# o'zidagi `.env`ga qo'ying, git'ga hech qachon committed qilinmasin.
DONATE_CARD_VISA=
DONATE_CARD_UZCARD=
DONATE_CARD_HOLDER=

# ── Voqealar jurnali: all | important | off ───────────────
EVENT_LOG_LEVEL=all
SESSION_WINDOW_MINUTES=30

# ── Ilova ─────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
AUTO_CREATE_SCHEMA=False
