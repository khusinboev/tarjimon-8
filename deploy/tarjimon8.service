[Unit]
Description=Tarjimon-8 Telegram bot
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
# Botni qayta ishga tushirish sikliga tushib qolishdan saqlaydi:
# 5 daqiqada 5 martadan ko'p yiqilsa, xizmat to'xtaydi va diqqat talab qiladi.
# Diqqat: bu direktivalar [Unit] da bo'lishi shart, [Service] da e'tiborsiz qoladi.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Imtiyozsiz tizim foydalanuvchisi (2026-11 auditi: root sifatida ishlash bot
# yoki kutubxona buzilsa butun serverni — boshqa loyihalarni ham — xavfga qo'yardi).
# Bot diskka yozmaydi: kod/venv root'niki (faqat o'qiladi), `.env` — root:tarjimon8 640.
# Bir martalik tayyorgarlik: DEPLOY.md "Imtiyozsiz foydalanuvchi".
User=tarjimon8
Group=tarjimon8
WorkingDirectory=/home/tarjimon8/app
EnvironmentFile=/home/tarjimon8/app/.env
ExecStart=/home/tarjimon8/venv/bin/python -m bot.main

Restart=always
RestartSec=5s

MemoryMax=1G
# Loglar journald ga tushadi: journalctl -u tarjimon8 -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tarjimon8

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
