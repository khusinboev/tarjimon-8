[Unit]
Description=Tarjimon-8 lokal tarjima modeli (NLLB-200, CTranslate2, CPU)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Imtiyozsiz vaqtinchalik foydalanuvchi — faqat o'qiydi, hech narsa yozmaydi.
DynamicUser=yes
WorkingDirectory=/home/tarjimon8/app
# v1p — v1 (bot korpusida LoRA fine-tune) + lug'at 256k -> 133k (22 til),
# mt/tools/prune_vocab.py; sifat bir xil (FLORES devtest 44 yo'nalish 54.86 = 54.86).
# Orqaga qaytish: nllb-1.3B-tarjimon-v1-ct2-int8 yoki nllb-200-distilled-1.3B-ct2-int8.
Environment=MT_MODEL_DIR=/home/tarjimon8/models/nllb-1.3B-tarjimon-v1p-ct2-int8
Environment=MT_LID_PATH=/home/tarjimon8/models/lid/lid.176.ftz
Environment=MT_HOST=127.0.0.1
Environment=MT_PORT=8790
# 2 — o'lchov bilan tanlangan (2026-11-12, shu serverda, navbatma-navbat):
# qisqa gap 2 oqim ~1.0-1.4 s, 1 oqim 1.6 s, 3 oqim 2.8-3.9 s, 4 oqim 3.5 s.
# 4 vCPU umumiy (oversubscribed) — 3+ OpenMP oqimi bir-birini kutib qoladi.
Environment=MT_THREADS=2
Environment=MT_BEAM=2
Environment=MT_MAX_QUEUE=8
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/tarjimon8/mt-venv/bin/python -m mt.server

Restart=on-failure
RestartSec=10s

# Boshqa loyihalarga (bot, tizor-bot, Postgres) xalal bermasin:
# - RAM qattiq chegarasi (model ~1.5 GB);
# - CPU: ko'pi bilan 3 yadro, va band paytda boshqalardan keyin.
MemoryMax=2560M
MemorySwapMax=0
CPUQuota=300%
CPUWeight=30
Nice=10
IOWeight=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tarjimon8-mt

[Install]
WantedBy=multi-user.target
